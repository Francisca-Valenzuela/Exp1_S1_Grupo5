spring.application.name=banco-xyz-batch
spring.batch.job.enabled=false

# Evita que el job se dispare automáticamente en cada arranque si más adelante quieres controlarlo por parámetros
spring.batch.jdbc.initialize-schema=always

# PostgreSQL (vía Docker)
spring.datasource.url=jdbc:postgresql://localhost:5432/bancoxyz
spring.datasource.driver-class-name=org.postgresql.Driver
spring.datasource.username=bancoxyz
spring.datasource.password=bancoxyz123
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true


# --- Optimizacion de recursos (Semana 2) ---

# el pool de conexiones debe acompanar el paralelismo: 3 hilos batch + margen
spring.datasource.hikari.maximum-pool-size=6
spring.datasource.hikari.minimum-idle=3
spring.datasource.hikari.connection-timeout=30000

# logs para trazar rendimiento y ejecucion de Spring Batch
logging.level.com.duoc.bancoxyzbatch=INFO
logging.level.org.springframework.batch=INFO

# --- Escalado con particiones (Semana 3) ---
# cantidad de particiones por Job; se probo con 2, 3 y 4 para comparar tiempos
# y encontrar la configuracion optima (ver README)
batch.partition.grid-size=3

# limite de omisiones (skip) por step/particion; el CSV oficial de la Semana 3
# trae bastantes filas con datos invalidos a proposito
batch.skip-limit=300

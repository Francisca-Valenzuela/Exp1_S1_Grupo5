package com.duoc.bffweb.client;

import java.util.List;

/** Espejo EXACTO del payload JSON de GET /internal/cuentas/{id} en banco-xyz-core. */
public class CuentaCoreDTO {
    private Long cuentaId;
    private String nombre;
    private Integer edad;
    private String tipo;
